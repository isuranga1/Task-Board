# Copy to backend/.env for running the backend NATIVELY (no Docker).
#
# For the Docker Compose deployment (see ../DEPLOY.md), this file is NOT
# used — docker-compose.yml builds DATABASE_URL itself from the root
# .env's POSTGRES_* vars, and passes the rest as container env vars.

DATABASE_URL=postgresql://dashboard_user:changeme@localhost:5432/task_dashboard

# Must be a JSON array, even for one origin.
CORS_ORIGINS=["http://localhost:5173"]

UPLOADS_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# Optional — email reminders. Leave blank to disable (app runs fine without them).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REMINDER_TO_EMAIL=
