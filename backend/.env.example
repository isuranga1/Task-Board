# Copy to backend/.env for running the backend NATIVELY (no Docker).
#
# For the Docker Compose deployment (see ../DEPLOY.md), this file is NOT
# used — docker-compose.yml builds DATABASE_URL itself from the root
# .env's POSTGRES_* vars, and passes the rest as container env vars.

DATABASE_URL=postgresql://dashboard_user:changeme@localhost:5432/task_dashboard

# Must be a JSON array, even for one origin.
CORS_ORIGINS=["http://localhost:5173"]

UPLOADS_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# Optional — email reminders. Leave blank to disable (app runs fine without them).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REMINDER_TO_EMAIL=

# Optional — Google Calendar sync. Leave blank to disable. For local dev the
# defaults below already match a "Web application" OAuth client configured with
# http://localhost:8000/gcal/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/gcal/callback
FRONTEND_URL=http://localhost:5173

# Optional — the Grow orb (the floating circle that suggests one grown-up
# thing to learn). Leave blank to disable. Key from openrouter.ai/keys.
# Real money: set a spend limit on the key in OpenRouter's dashboard too.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Generations per day, counted in UTC.
GROWTH_DAILY_LIMIT=25
