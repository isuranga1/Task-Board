# Copy to `.env` in this same directory (repo root) before running
# `docker compose up`. This drives docker-compose.yml only — it's separate
# from backend/.env, which is for running the backend natively without Docker.
# See DEPLOY.md for the full walkthrough.

POSTGRES_USER=dashboard_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=task_dashboard

# Must be a JSON array, even for one origin. Use the address other devices
# will actually load the frontend from — your Pi's Tailscale MagicDNS name
# is the stable choice (find it with `tailscale status` on the Pi).
CORS_ORIGINS=["http://raspberrypi.tailxxxxx.ts.net"]

# Baked into the frontend at BUILD time (Vite inlines VITE_* vars) — point
# this at the backend's Tailscale address + port 8000. Changing it requires
# rebuilding the frontend image: `docker compose up -d --build frontend`.
VITE_API_URL=http://raspberrypi.tailxxxxx.ts.net:8000

# Optional — email reminders. Leave blank to disable (app runs fine without them).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REMINDER_TO_EMAIL=

# Optional — Google Calendar sync. Leave blank to disable; the Calendar page
# still works, it just shows task deadlines only. See DEPLOY.md §8 for how to
# create the OAuth client these come from.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be byte-for-byte identical to a redirect URI listed on that OAuth
# client, or Google returns redirect_uri_mismatch. Same host as VITE_API_URL.
GOOGLE_REDIRECT_URI=http://raspberrypi.tailxxxxx.ts.net:8000/gcal/callback
# Where the browser lands after consent — the FRONTEND's origin (port 80),
# not the API's. Defaults to the first CORS_ORIGINS entry if left blank.
FRONTEND_URL=http://raspberrypi.tailxxxxx.ts.net

# Optional — the two features that talk to an LLM, which share one key:
#   * the Grow orb (the floating circle that suggests one grown-up thing to learn)
#   * the look-back on Insights (a written review of your week, month or year,
#     from the tasks you finished and what you noted when finishing each one)
# Leave blank to disable both; each then just explains it isn't configured.
# Get a key at openrouter.ai/keys. See DEPLOY.md §9.
#
# This key can spend real money. Keep it out of git (.env is already ignored),
# and set a spend limit on the key itself in the OpenRouter dashboard so the
# app's daily cap isn't the only thing standing between you and a bill.
OPENROUTER_API_KEY=
# Any OpenRouter model slug. Cheap and good enough for this; swap freely.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Generations per day, counted in UTC. Each refuses past its own limit — two
# counters, so a busy day of Grow clicks can't leave you unable to write a
# weekly review. A review is the bigger prompt of the two, hence the lower cap.
GROWTH_DAILY_LIMIT=25
SUMMARY_DAILY_LIMIT=10
