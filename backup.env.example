# Copy to backup.env (repo root) before running scripts/backup-db.sh.
# POSTGRES_USER / POSTGRES_DB are read from your existing .env — no need
# to repeat them here.
#
# Each off-Pi destination below is independently optional — enable one or
# both. If both are false, backups only ever exist locally on the Pi.

# ---------- Google Drive (via rclone) ----------
BACKUP_TO_GDRIVE=true
GDRIVE_REMOTE_NAME=gdrive
GDRIVE_FOLDER=task-board-backups
# "Renew daily": anything older than this gets deleted from Drive each run,
# so the folder stays a rolling window instead of growing forever.
GDRIVE_RETENTION_DAYS=30

# ---------- Another device on your tailnet (via scp) ----------
BACKUP_TO_REMOTE=false
BACKUP_REMOTE_USER=isura
BACKUP_REMOTE_HOST=my-pc.tailxxxxx.ts.net
# Linux/Mac remote: a plain path, e.g. /home/isura/task-board-backups
# Windows remote (OpenSSH Server): forward slashes work, e.g. C:/Backups/task-board
BACKUP_REMOTE_PATH=/home/isura/task-board-backups
# Dedicated deploy-style key so cron can scp non-interactively.
# Leave blank to use ssh's default identity instead.
BACKUP_SSH_KEY=/home/pi/.ssh/backup_key

# How many days of LOCAL backups to keep on the Pi.
LOCAL_RETENTION_DAYS=14
